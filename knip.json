{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "packages/core": {
      "entry": ["src/index.ts", "src/sw/index.ts", "src/internal/index.ts", "src/testing/index.ts"],
      "project": "src/**/*.{ts,tsx}"
    },
    "packages/ui": {
      "entry": ["src/index.ts", "src/tailwind/index.ts"],
      "project": "src/**/*.{ts,tsx}"
    },
    "examples/playground": {
      "project": "src/**/*.{ts,tsx}",
      "ignoreDependencies": ["tailwindcss"]
    }
  }
}
