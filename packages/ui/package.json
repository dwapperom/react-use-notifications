{
  "name": "react-use-notifications-ui",
  "version": "0.1.0",
  "description": "Headless and Tailwind-styled React components for react-use-notifications",
  "license": "MIT",
  "author": "dwapperom",
  "homepage": "https://github.com/dwapperom/react-use-notifications/tree/main/packages/ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dwapperom/react-use-notifications.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/dwapperom/react-use-notifications/issues"
  },
  "keywords": [
    "react",
    "notifications",
    "tailwind",
    "headless-ui",
    "toast"
  ],
  "sideEffects": false,
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./tailwind": {
      "import": {
        "types": "./dist/tailwind/index.d.mts",
        "default": "./dist/tailwind/index.mjs"
      },
      "require": {
        "types": "./dist/tailwind/index.d.ts",
        "default": "./dist/tailwind/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "tailwind": [
        "./dist/tailwind/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts src/tailwind/index.ts --format cjs,esm --dts --clean --sourcemap",
    "dev": "tsup src/index.ts src/tailwind/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:pkg": "publint && attw --pack .",
    "prepublishOnly": "pnpm run guard:pnpm && pnpm run build && pnpm run typecheck && pnpm run test && pnpm run check:pkg",
    "guard:pnpm": "node -e \"if (!(process.env.npm_config_user_agent || '').startsWith('pnpm')) { console.error('Publish this package with pnpm. npm leaves the workspace: protocol in peerDependencies, which makes the published package uninstallable.'); process.exit(1); }\"",
    "clean": "rm -rf dist node_modules coverage",
    "registry:build": "shadcn build registry.json --output ../../examples/playground/public/r"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-use-notifications": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^25.0.1",
    "publint": "^0.3.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-use-notifications": "workspace:*",
    "shadcn": "^2.3.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^3.0.2"
  }
}
